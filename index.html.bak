<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PS5 RENTAL — Аренда PlayStation 5</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="styles.css" />
</head>
<body>
  <div class="bg-glow" aria-hidden="true"></div>
  <div class="bg-grid" aria-hidden="true"></div>

  <header class="site-header">
    <div class="brand">
      <span class="brand-mark" aria-hidden="true"></span>
      <h1 class="brand-title">PS5 RENTAL</h1>
    </div>
    <div class="header-actions" id="header-actions" hidden>
      <span class="user-chip" id="user-chip"></span>
      <button type="button" class="btn btn-ghost" id="logout-btn">Выйти</button>
    </div>
  </header>

  <main>
    <!-- ========== CLIENT AUTH / LANDING ========== -->
    <section class="auth-screen" id="auth-screen">
      <div class="hero">
        <p class="hero-kicker">Аренда игровой консоли</p>
        <h2 class="hero-brand">PS5 RENTAL</h2>
        <p class="hero-lead">PlayStation 5 от 1&nbsp;200&nbsp;₽ / сутки. Зарегистрируйтесь, выберите категорию и оформите аренду — менеджер свяжется с вами.</p>
      </div>

      <div class="auth-panel">
        <!-- NEW: Admin entry point -->
        <div class="auth-tabs" role="tablist">
          <button type="button" class="auth-tab is-active" data-tab="login" role="tab" aria-selected="true">Вход</button>
          <button type="button" class="auth-tab" data-tab="register" role="tab" aria-selected="false">Регистрация</button>
          <button type="button" class="auth-tab" data-tab="admin" role="tab" aria-selected="false">Админ</button>
        </div>

        <form id="login-form" class="auth-form" autocomplete="on">
          <label class="field">
            <span>Телефон</span>
            <input type="text" name="login" id="login-login" placeholder="79026936225" required />
          </label>
          <label class="field">
            <span>Пароль</span>
            <input type="password" name="password" id="login-password" placeholder="••••••••" required minlength="6" />
          </label>
          <p class="form-hint">Клиент (тест): <strong>79026936225</strong> / <strong>12345678</strong></p>
          <p class="form-error" id="login-error" hidden></p>
          <button type="submit" class="btn btn-gold">Войти</button>
        </form>

        <form id="register-form" class="auth-form" hidden autocomplete="on">
          <label class="field">
            <span>ФИО</span>
            <input type="text" name="name" id="reg-name" placeholder="Иванов Иван Иванович" required />
          </label>
          <label class="field">
            <span>Телефон</span>
            <input type="text" name="login" id="reg-login" placeholder="79XXXXXXXXX" required />
          </label>
          <label class="field">
            <span>Пароль</span>
            <input type="password" name="password" id="reg-password" placeholder="минимум 6 символов" required minlength="6" />
          </label>
          <label class="field">
            <span>Повторите пароль</span>
            <input type="password" name="password2" id="reg-password2" required minlength="6" />
          </label>
          <p class="form-error" id="register-error" hidden></p>
          <button type="submit" class="btn btn-gold">Зарегистрироваться</button>
        </form>

        <!-- NEW: Admin login form (section 1) -->
        <form id="admin-login-form" class="auth-form" hidden autocomplete="on">
          <p class="form-hint">Вход для администратора</p>
          <label class="field">
            <span>Телефон</span>
            <input type="text" name="phone" id="admin-phone" placeholder="79821415152" required />
          </label>
          <label class="field">
            <span>Пароль</span>
            <input type="password" name="password" id="admin-password" placeholder="••••••••" required />
          </label>
          <p class="form-hint">Админ (тест): <strong>79821415152</strong> / <strong>1234567890</strong></p>
          <p class="form-error" id="admin-login-error" hidden></p>
          <button type="submit" class="btn btn-gold">Войти в панель</button>
        </form>
      </div>
    </section>

    <!-- ========== CLIENT BOOKING (after auth) ========== -->
    <section class="booking-screen" id="booking-screen" hidden>
      <!-- Главная: карточки + отзывы -->
      <div id="booking-home-view">
        <div class="booking-intro">
          <h2>Каталог аренды</h2>
          <p>Выберите категорию оборудования. Минимальный срок аренды — 24 часа.</p>
        </div>

        <nav class="product-cards" id="product-cards" aria-label="Каталог аренды">
          <button type="button" class="product-card" data-product="ps5">
            <div class="product-card-box" aria-hidden="true"></div>
            <p class="product-card-label">🔥 PS5/PS5 PRO</p>
          </button>
          <button type="button" class="product-card" data-product="vr2">
            <div class="product-card-box" aria-hidden="true"></div>
            <p class="product-card-label">🔥 VR2</p>
          </button>
          <button type="button" class="product-card" data-product="periphery">
            <div class="product-card-box" aria-hidden="true"></div>
            <p class="product-card-label">🔥 Периферия</p>
          </button>
        </nav>

        <section class="reviews-panel" aria-labelledby="reviews-title">
          <h3 id="reviews-title">Отзывы довольных клиентов</h3>
          <div class="reviews-grid">
            <article class="review-card">
              <p class="review-stars" aria-hidden="true">★★★★★</p>
              <p class="review-text">«Брал PS5 на выходные — всё привезли вовремя, комплект полный. FIFA и Mortal Kombat уже были установлены!»</p>
              <p class="review-author">— Алексей, Казань</p>
            </article>
            <article class="review-card">
              <p class="review-stars" aria-hidden="true">★★★★★</p>
              <p class="review-text">«VR2 — это что-то невероятное! Очки чистые, всё работает без глюков. Менеджер помог с настройкой по телефону.»</p>
              <p class="review-author">— Марина, Набережные Челны</p>
            </article>
            <article class="review-card">
              <p class="review-stars" aria-hidden="true">★★★★★</p>
              <p class="review-text">«Арендовал дополнительный геймпад и ТВ на неделю. Удобно, что можно всё в одном заказе. Рекомендую!»</p>
              <p class="review-author">— Дамир, Казань</p>
            </article>
            <article class="review-card">
              <p class="review-stars" aria-hidden="true">★★★★★</p>
              <p class="review-text">«Брал консоль на день рождения сына — восторг! Сумка, зарядка, HDMI — всё в комплекте, ничего докупать не пришлось.»</p>
              <p class="review-author">— Елена, Альметьевск</p>
            </article>
            <article class="review-card">
              <p class="review-stars" aria-hidden="true">★★★★★</p>
              <p class="review-text">«Третий раз беру в аренду — цены адекватные, даты в календаре всегда актуальные. Самовывоз удобный.»</p>
              <p class="review-author">— Ильдар, Казань</p>
            </article>
            <article class="review-card">
              <p class="review-stars" aria-hidden="true">★★★★★</p>
              <p class="review-text">«Заказал периферию отдельно — геймпад и наушники. Быстрая доставка, всё как новое. Спасибо команде!»</p>
              <p class="review-author">— Руслан, Зеленодольск</p>
            </article>
          </div>
        </section>
      </div>

      <!-- Подраздел: календарь + оформление заказа -->
      <div id="product-detail-view" hidden>
        <button type="button" class="btn-back" id="back-to-home">← Назад к каталогу</button>

        <header class="product-detail-header">
          <h2 id="product-detail-title">PS5 / PS5 PRO</h2>
          <p id="product-detail-desc">Выберите даты аренды и способ получения. Менеджер свяжется с вами для уточнения деталей.</p>
        </header>

        <div class="booking-grid">
          <div class="calendar-panel">
            <div class="calendar-modes" id="calendar-modes">
              <button type="button" class="mode-btn is-active" data-mode="range">Период (начало → конец)</button>
              <button type="button" class="mode-btn" data-mode="week">Заполнить неделю</button>
            </div>
            <p class="calendar-hint" id="calendar-hint">Выберите дату начала — конец по умолчанию +1 день (24 ч).</p>

            <div class="calendar-nav">
              <button type="button" class="btn btn-icon" id="prev-month" aria-label="Предыдущий месяц">‹</button>
              <h3 id="calendar-month-label"></h3>
              <button type="button" class="btn btn-icon" id="next-month" aria-label="Следующий месяц">›</button>
            </div>
            <div class="calendar-weekdays" aria-hidden="true">
              <span>Пн</span><span>Вт</span><span>Ср</span><span>Чт</span><span>Пт</span><span>Сб</span><span>Вс</span>
            </div>
            <div class="calendar-days" id="calendar-days"></div>
            <div class="calendar-legend">
              <span><i class="dot available"></i> Свободно</span>
              <span><i class="dot selected"></i> Период</span>
              <span><i class="dot range-end"></i> Начало / конец</span>
              <span><i class="dot booked"></i> Занято</span>
              <span><i class="dot past"></i> Недоступно</span>
            </div>
            <button type="button" class="btn btn-ghost btn-block" id="clear-range-btn">Сбросить даты</button>
          </div>

          <div class="checkout-panel">
            <!-- Комплектация PS5 (только для ps5) -->
            <section class="kit-section" id="ps5-kit-section" hidden aria-labelledby="kit-title">
              <h3 id="kit-title">Комплектация</h3>
              <div class="kit-grid">
                <div class="kit-item">
                  <span class="kit-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><rect x="4" y="8" width="16" height="8" rx="2"/><circle cx="8" cy="12" r="1.5" fill="currentColor" stroke="none"/><circle cx="16" cy="12" r="1.5" fill="currentColor" stroke="none"/></svg>
                  </span>
                  <span class="kit-label">Два геймпада</span>
                </div>
                <div class="kit-item">
                  <span class="kit-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M8 10h8M8 14h5"/></svg>
                  </span>
                  <span class="kit-label">Игры</span>
                </div>
                <div class="kit-item">
                  <span class="kit-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M12 3v4M8 7h8"/><rect x="6" y="7" width="12" height="14" rx="2"/><path d="M10 14h4"/></svg>
                  </span>
                  <span class="kit-label">Зарядка</span>
                </div>
                <div class="kit-item">
                  <span class="kit-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M6 8h12l-1 12H7L6 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
                  </span>
                  <span class="kit-label">Переносная сумка</span>
                </div>
                <div class="kit-item">
                  <span class="kit-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M4 8h16v2H4z"/><path d="M6 10v6M10 10v6M14 10v6M18 10v6"/><path d="M8 16h8"/></svg>
                  </span>
                  <span class="kit-label">Кабель HDMI</span>
                </div>
              </div>
            </section>

            <!-- Доп. периферия для PS5 -->
            <section class="extras-section" id="ps5-extras-section" hidden aria-labelledby="extras-title">
              <h3 id="extras-title">Дополнительная периферия</h3>
              <div class="extras-list">
                <label class="checkbox-row">
                  <input type="checkbox" id="extra-gamepad" value="gamepad" />
                  <span>Дополнительный геймпад</span>
                </label>
                <label class="checkbox-row">
                  <input type="checkbox" id="extra-tv" value="tv" />
                  <span>Телевизор</span>
                </label>
              </div>
              <p class="extras-hint">Отметьте, если нужно что-то дополнительно — менеджер уточнит модель и стоимость.</p>
            </section>

            <div class="order-summary">
              <h3>Ваш заказ</h3>
              <ul class="selected-dates" id="selected-dates-list">
                <li class="empty">Период не выбран</li>
              </ul>
              <div class="total-row">
                <span>Итого</span>
                <strong id="total-price">0 ₽</strong>
              </div>
              <p class="rate-note" id="pricing-note">Тариф: 1 дн. — 1&nbsp;200&nbsp;₽ · 2 — 2&nbsp;000 · 3 — 2&nbsp;700 · далее 700/дн. · после 7 дн. — 600/дн.</p>
            </div>

            <form id="order-form" class="order-form payment-form">
              <fieldset class="fulfillment">
                <legend>Способ получения</legend>
                <label class="radio-row">
                  <input type="radio" name="fulfillment" value="delivery" id="opt-delivery" checked />
                  <span>Доставка</span>
                </label>
                <label class="radio-row">
                  <input type="radio" name="fulfillment" value="pickup" id="opt-pickup" />
                  <span>Самовывоз</span>
                </label>
                <div id="delivery-address-wrap">
                  <label class="field">
                    <span>Адрес доставки</span>
                    <input type="text" id="delivery-address" name="deliveryAddress" placeholder="Город, улица, дом, квартира" />
                  </label>
                </div>
                <p class="pickup-note" id="pickup-note" hidden>
                  Пункт самовывоза: г. Казань, ул. Баумана, 15 (Пн–Вс 11:00–21:00)
                </p>
              </fieldset>

              <div class="terms-block">
                <h3>Условия использования (оферта)</h3>
                <div class="terms-text" tabindex="0">
                  <p>1. Арендодатель передаёт, а Арендатор принимает во временное пользование оборудование с комплектацией, указанной при оформлении заказа.</p>
                  <p>2. Минимальный срок аренды — 24 часа. Стоимость рассчитывается по действующему тарифу в зависимости от длительности.</p>
                  <p>3. Арендатор обязуется бережно относиться к оборудованию и не передавать его третьим лицам без согласия Арендодателя.</p>
                  <p>4. При повреждении или утрате оборудования Арендатор возмещает стоимость ремонта или полную стоимость комплекта.</p>
                  <p>5. Оплата и детали заказа уточняются менеджером после оформления заявки.</p>
                  <p>6. Самовывоз осуществляется по адресу пункта выдачи. При доставке Арендатор указывает актуальный адрес.</p>
                </div>
                <label class="checkbox-row">
                  <input type="checkbox" id="terms-agree" name="termsAgree" />
                  <span>Я согласен с условиями использования (офертой)</span>
                </label>
              </div>

              <p class="form-error" id="order-error" hidden></p>
              <button type="submit" class="btn btn-gold" id="order-btn" disabled>Оформить заказ</button>
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- ========== ADMIN DASHBOARD (section 2) ========== -->
    <section class="admin-screen" id="admin-screen" hidden>
      <div class="booking-intro">
        <h2>Панель администратора</h2>
        <p>Активные заказы и база клиентов.</p>
      </div>

      <div class="admin-tabs" role="tablist">
        <button type="button" class="admin-tab is-active" data-admin-tab="orders">Активные заказы</button>
        <button type="button" class="admin-tab" data-admin-tab="clients">База клиентов</button>
      </div>

      <div id="admin-orders-panel" class="admin-panel">
        <div class="table-wrap">
          <table class="data-table" id="orders-table">
            <thead>
              <tr>
                <th>ID заказа</th>
                <th>Клиент</th>
                <th>Начало</th>
                <th>Конец</th>
                <th>Статус</th>
                <th>Сумма</th>
              </tr>
            </thead>
            <tbody id="orders-tbody">
              <tr><td colspan="6" class="empty-cell">Заказов пока нет</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <div id="admin-clients-panel" class="admin-panel" hidden>
        <div class="table-wrap">
          <table class="data-table" id="clients-table">
            <thead>
              <tr>
                <th>ФИО</th>
                <th>Телефон</th>
              </tr>
            </thead>
            <tbody id="clients-tbody">
              <tr><td colspan="2" class="empty-cell">Клиентов пока нет</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </main>

  <div class="toast" id="toast" hidden role="status"></div>

  <div class="modal" id="success-modal" hidden>
    <div class="modal-card">
      <div class="modal-icon" aria-hidden="true">✓</div>
      <h3>Заявка отправлена</h3>
      <p id="success-text"></p>
      <button type="button" class="btn btn-gold" id="success-close">Готово</button>
    </div>
  </div>

  <!-- inject:main-js -->
  <script src="js/main.js"></script>
  <!-- /inject:main-js -->
</body>
</html>
